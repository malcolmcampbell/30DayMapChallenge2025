          <value/>
        </Data>
        <Data name="website (or Fb)">
          <value/>
        </Data>
        <Data name="Address">
          <value>Rooms E5-E7, Block E. Hagley Community College, 510 Hagley Avenue, Christchurch, 8011</value>
        </Data>
        <Data name="Subject">
          <value>Community groups, Islam, Trusts and trustees, Ethnic groups, Muslims, Health and welfare, After-school programmes, Arabic language</value>
        </Data>
        <Data name="Last update">
